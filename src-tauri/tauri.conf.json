{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inskea",
  "version": "0.10.0",
  "identifier": "io.github.quippy22.inskea",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "trunk serve",
    "beforeBuildCommand": "trunk build --release"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Inskea",
        "width": 800,
        "height": 600,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/fonts/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Quippy22",
    "homepage": "https://github.com/Quippy22/Inskea",
    "license": "MIT",
    "category": "GraphicsAndDesign",
    "shortDescription": "Infinite-canvas drawing app",
    "longDescription": "Inskea is an infinite-canvas drawing application for sketching shapes, freehand strokes, and text.",
    "resources": ["fonts/*"],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/inskea.desktop",
        "files": {
          "/usr/share/mime/packages/inskea.xml": "linux/inskea-mime.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/inskea.desktop",
        "files": {
          "/usr/share/mime/packages/inskea.xml": "linux/inskea-mime.xml"
        }
      }
    },
    "fileAssociations": [
      {
        "description": "Inskea Drawing",
        "ext": ["skea"],
        "mimeType": "application/x-inskea",
        "name": "Inskea Drawing",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "io.github.quippy22.inskea.drawing",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
